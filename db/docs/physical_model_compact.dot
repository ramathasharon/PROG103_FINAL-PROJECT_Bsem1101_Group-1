digraph PhysicalModel {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.7, fontname="Helvetica", bgcolor="white", pad=0.3];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#34495e", dir=both];

  districts [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2f5496" COLSPAN="3"><FONT COLOR="white"><B>districts</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">district_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT">TEXT  (CHECK)</TD></TR>
    </TABLE>>];

  applicants [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2f5496" COLSPAN="3"><FONT COLOR="white"><B>applicants</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">applicant_id</TD><TD ALIGN="LEFT">TEXT  (APP-001)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT">TEXT  (3-60)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">TEXT  (pattern)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">district</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">date_registered</TD><TD ALIGN="LEFT">DATE</TD></TR>
    </TABLE>>];

  permits [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#1a7f37" COLSPAN="3"><FONT COLOR="white"><B>permits</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">permit_id</TD><TD ALIGN="LEFT">TEXT  (PRM-001)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">applicant_id</TD><TD ALIGN="LEFT">TEXT  NOT NULL</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">TEXT  NOT NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT">TEXT  (3-120)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">TEXT  (5 values)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">office_name</TD><TD ALIGN="LEFT">TEXT  NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">date_applied</TD><TD ALIGN="LEFT">DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">issue_date</TD><TD ALIGN="LEFT">DATE  NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">expiry_date</TD><TD ALIGN="LEFT">DATE  NULL</TD></TR>
    </TABLE>>];

  permit_types [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2f5496" COLSPAN="3"><FONT COLOR="white"><B>permit_types</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">type_name</TD><TD ALIGN="LEFT">TEXT  UNIQUE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">details_label</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">base_fee</TD><TD ALIGN="LEFT">NUMERIC(10,2)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">validity_years</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
    </TABLE>>];

  offices [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2f5496" COLSPAN="3"><FONT COLOR="white"><B>offices</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
    </TABLE>>];

  office_permit_types [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#b36b00" COLSPAN="3"><FONT COLOR="white"><B>office_permit_types</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD ALIGN="LEFT">office_name</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">TEXT</TD></TR>
    </TABLE>>];

  permit_history [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#7a7a7a" COLSPAN="3"><FONT COLOR="white"><B>permit_history</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">history_id</TD><TD ALIGN="LEFT">BIGSERIAL</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">permit_id</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">old_status</TD><TD ALIGN="LEFT">TEXT  NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">new_status</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">office_name</TD><TD ALIGN="LEFT">TEXT  NULL</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT">TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">changed_at</TD><TD ALIGN="LEFT">TIMESTAMP</TD></TR>
    </TABLE>>];

  // one district has many applicants (1 : N)
  districts -> applicants [label="  1 : N  has", arrowtail=tee, arrowhead=crowodot];
  // one applicant files many permits
  applicants -> permits [label="  1 : N  files", arrowtail=tee, arrowhead=crowodot];
  // a permit has one type
  permit_types -> permits [label="  1 : N  classifies", arrowtail=tee, arrowhead=crowodot];
  // an office decides on many permits (optional until assigned)
  offices -> permits [label="  0..1 : N  decides", arrowtail=teeodot, arrowhead=crowodot];
  // a permit has many history rows
  permits -> permit_history [label="  1 : N  logs", arrowtail=tee, arrowhead=crowodot];
  // many-to-many through the junction table
  offices -> office_permit_types [label="  1 : N", arrowtail=tee, arrowhead=crowodot];
  permit_types -> office_permit_types [label="  1 : N", arrowtail=tee, arrowhead=crowodot];

  { rank=same; permit_types; offices }
  { rank=same; districts; applicants }
}
